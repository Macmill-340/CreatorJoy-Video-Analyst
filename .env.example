# Required: Google AI Studio key for Gemini 2.0 Flash Lite
GEMINI_API_KEY=

# Required: JWT signing secrets. SECRET_ENV_KEY should be a long random string.
SECRET_ENV_KEY=replace-me-with-a-long-random-string
ALGORITHM_ENV_KEY=HS256

# Optional: comma-separated list of frontend origins allowed by CORS.
# Defaults to local Vite dev. In production set to your real frontend URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Streamlit fallback client points here
BACKEND_URL=http://127.0.0.1:8000
